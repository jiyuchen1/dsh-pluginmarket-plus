{
  "name": "dsh-pluginmarket-plus",
  "version": "0.2.1",
  "description": "Plugin market enhancements for DeepSeek Harness: cache the market index JSON on local disk with a local mirror for the Discover page, and check or batch-update installed plugins with progress, cancellation and version exemptions.",
  "type": "module",
  "main": "./lib/index.js",
  "icon": "icon.svg",
  "author": "jiyuchen1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jiyuchen1/dsh-pluginmarket-plus.git"
  },
  "homepage": "https://github.com/jiyuchen1/dsh-pluginmarket-plus#readme",
  "bugs": {
    "url": "https://github.com/jiyuchen1/dsh-pluginmarket-plus/issues"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.1 <0.2.2-0 || >=0.2.2-rc.1 <0.4.0-0"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "plugin-market",
    "cache",
    "index"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "test": "node tools/updates-selftest.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
